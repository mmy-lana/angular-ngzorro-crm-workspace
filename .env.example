CRM_APP_NAME="angular-ngzorro-crm-workspace"
CRM_APP_ENV="development"

# Controls whether the first run of an empty workspace is populated with the
# fictional seed dataset (10 accounts / 25 contacts / 15 opportunities / 40
# activities).
#
# Development:  leave unset or set to "true" for a populated demo workspace.
# Production:   set to "false".
#
# An empty production store means "no records yet", and filling it with invented
# customers is both a data-integrity incident and a confidentiality problem, so
# seeding is opt-in rather than automatic.
CRM_SEED_DEMO_DATA="true"
